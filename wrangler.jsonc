{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flarebase",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-16",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fb",
			"database_id": "d824c39e-2eca-4465-86a9-9776d7eefa41"
		}
	]
}