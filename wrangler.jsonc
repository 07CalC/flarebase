{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flarebase",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-16",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"r2_buckets": [
		{
			"binding": "FILE_BUCKET",
			"bucket_name": "flarebase-files"
		}
	],
	"vars": {
		"SESSION_TTL_SECONDS": "604800"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fb",
			"database_id": "d824c39e-2eca-4465-86a9-9776d7eefa41",
			"migrations_dir": "./migrations/",
			"migrations_table": "migrations"
		}
	]
}
